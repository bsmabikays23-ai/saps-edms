# ============================================================================
# SAPS eDMS — Environment variables (EXAMPLE)
# Copy this file to .env and fill in your own values.
# ============================================================================

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=generate-a-long-random-string

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SAPS_JWT_SECRET=generate-a-64-char-hex-string

# Database
DATABASE_URL=sqlite:///saps_edms.db

# Gmail SMTP (use an app password, not your Google password)
# Generate at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=SAPS eDMS <you@example.com>

# Server
HOST=0.0.0.0
PORT=5000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Rate limiting — e.g. "5 per minute" for login, "200 per day" global
LOGIN_RATE_LIMIT=5 per minute